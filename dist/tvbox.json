name: 影视仓配置自动同步
on:
  schedule:
    - cron: '0 */6 * * *'  # 每6小时自动更新
  workflow_dispatch:        # 支持手动触发

jobs:
  sync-config:
    runs-on: ubuntu-latest
    permissions:
      contents: write       # 赋予提交推送权限，解决403
    steps:
      - name: 拉取仓库代码
        uses: actions/checkout@v4

      - name: 拉取标准影视仓配置
        run: |
          mkdir -p dist
          # 拉取影视仓标准JSON配置
          curl -L -s "https://raw.githubusercontent.com/FongMi/TV/release/config.json" -o dist/tvbox.json

      - name: 提交更新文件
        uses: EndBug/add-and-commit@v9
        with:
          message: "🤖 定时自动更新影视仓配置"
          add: "dist/*"
